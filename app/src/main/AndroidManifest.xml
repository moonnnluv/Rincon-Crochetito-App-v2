<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rincon_crochetitov2">
        <activity
            android:name=".Administrador.Productos.AgregarProductoActivity"
            android:exported="false" />
        <activity
            android:name=".SeleccionarTipoActivity"
            android:exported="false" />
        <activity
            android:name=".Cliente.LoginClienteActivity"
            android:exported="false" />
        <activity
            android:name=".Cliente.RegistroClienteActivity"
            android:exported="false" />
        <activity
            android:name=".SplashScreenActivity"
            android:exported="false" />
        <activity
            android:name=".Cliente.MainActivityCliente"
            android:exported="false" />
        <activity
            android:name=".Administrador.LoginActivityAdmin"
            android:exported="false" />
        <activity
            android:name=".Administrador.RegistroAdminActivity"
            android:exported="false" />
        <activity
            android:name=".Administrador.MainActivityAdmin"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Rincon_crochetitov2">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>